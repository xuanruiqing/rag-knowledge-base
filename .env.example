# ========== LLM（OpenAI 兼容接口，示例为火山方舟 Ark）==========
VOLC_ARK_KEY=your_ark_api_key
VOLC_MODEL_EP=your_endpoint_id
LLM_TEMPERATURE=0.3

# ========== Embedding + Rerank（阿里百炼 DashScope）==========
DASHSCOPE_API_KEY=your_dashscope_api_key
EMBED_MODEL=text-embedding-v4
RERANK_MODEL=gte-rerank-v2

# ========== RAG 参数 ==========
CHUNK_SIZE=400
CHUNK_OVERLAP=60
RETRIEVE_TOP_K=5
RERANK_TOP_K=3
SIMILAR_THRESHOLD=0.20
DEBUG_SIMILARITY=False

# ========== 会话 ==========
MAX_CHAT_TURN=6
